# ─── Database (PostgreSQL) ────────────────────────────────────────────
# Pooled connection used at runtime (e.g. Neon/Supabase pooler URL with ?pgbouncer=true on Supabase)
DATABASE_URL="postgresql://user:password@host:5432/mvmarkets?sslmode=require"
# Direct (non-pooled) connection used by `prisma migrate deploy`
DIRECT_URL="postgresql://user:password@host:5432/mvmarkets?sslmode=require"

# ─── App ──────────────────────────────────────────────────────────────
# Public base URL (used in email links). On Vercel set to your production domain.
APP_URL="https://mvmarkets.mv"
# Long random string (min 32 chars) — used for OTP/IP hashing. Generate: openssl rand -base64 48
AUTH_SECRET=""
# Secret Vercel Cron sends as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=""

# ─── First super admin (created on deploy / `npm run db:seed` if missing) ──────
# Log in with ADMIN_USERNAME (or ADMIN_EMAIL). ADMIN_EMAIL is optional when a username is set.
ADMIN_USERNAME="Admin"
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="OceanX Admin"

# ─── Email (OTP codes & notifications) — https://resend.com ───────────
# Optional. Without it: new accounts are auto-verified, admins sign in with password only,
# password reset by email is unavailable. Everything switches on once the key is set.
RESEND_API_KEY=""
EMAIL_FROM="MV Markets <no-reply@mvmarkets.mv>"

# ─── SMS (optional phone verification) ────────────────────────────────
# SMS_PROVIDER="twilio" | "webhook"
SMS_PROVIDER=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""
# Generic gateway (e.g. a local Maldivian SMS provider): POST {to, message} JSON
SMS_WEBHOOK_URL=""
SMS_WEBHOOK_TOKEN=""

# ─── AI payment-slip screening (optional; without it slips go straight to human review)
ANTHROPIC_API_KEY=""
AI_MODEL="claude-opus-5"

# ─── File storage ─────────────────────────────────────────────────────
# "database" (default, zero setup) or "s3" (any S3-compatible bucket: AWS S3, Cloudflare R2, Supabase Storage)
STORAGE_DRIVER="database"
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
